# 统一换行：仓库内存 LF，检出时按平台转换。
# 避免 git 每次都提示 "LF will be replaced by CRLF"。
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ogg binary
*.zip binary
*.nbt binary
*.glb binary
*.gltf text eol=lf
